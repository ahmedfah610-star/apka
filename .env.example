# Sklep Fasolka działa bez żadnych zmiennych środowiskowych.
# Poniższe są opcjonalne — włączają dodatkowe funkcje.

# Token InPost Geowidget — włącza PRAWDZIWĄ mapę wszystkich paczkomatów
# w kroku dostawy. Bez niego pokazuje się lista poglądowa.
# Token pobierzesz z panelu InPost (Geowidget). Jest publiczny (client-side),
# dlatego prefiks NEXT_PUBLIC_. Dodaj go też w Vercel → Settings → Environment Variables.
NEXT_PUBLIC_INPOST_GEOWIDGET_TOKEN=
