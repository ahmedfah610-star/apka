# Sklep Fasolka działa bez żadnych zmiennych środowiskowych (fallback: katalog
# z kodu, 238 produktów). Poniższe włączają realne funkcje: wspólną bazę,
# panel admina, mapę InPost.

# ── Supabase (wspólna baza: produkty, stany magazynowe, zamówienia, zdjęcia) ──
# Załóż darmowy projekt na supabase.com → Settings → API. Uruchom w SQL Editor
# pliki supabase/schema.sql oraz supabase/seed.sql, a w Storage utwórz publiczny
# bucket o nazwie "produkty".
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Klucz service_role (SEKRETNY — tylko po stronie serwera, nie ujawniaj).
# Potrzebny do zapisu z panelu i atomowego zmniejszania stanów przy zamówieniu.
SUPABASE_SERVICE_ROLE_KEY=

# ── Panel administracyjny (/admin) ──
# Hasło sprawdzane po stronie serwera; sesja trzymana w cookie httpOnly.
# Bez tej zmiennej panel jest zablokowany.
ADMIN_HASLO=

# ── InPost Geowidget (oficjalna mapa paczkomatów) ──
# Token z konta InPost (typ: Geowidget v5). Gdy ustawiony — w kroku dostawy
# pokazuje się oficjalna mapa InPost. BEZ tokenu wybór paczkomatu też działa
# (własna mapa Leaflet + lista z publicznego API ShipX).
NEXT_PUBLIC_INPOST_GEOWIDGET_TOKEN=

# ── Płatności online — Przelewy24 (BLIK, przelewy, karta w jednym panelu) ──
# Dane z panelu Przelewy24 → Moje dane / Konfiguracja / API. Gdy ustawione,
# checkout kieruje płatność do Przelewy24 (ma pierwszeństwo przed Stripe).
# W panelu P24 dodaj też adres powiadomień (urlStatus): /api/platnosc/p24/webhook
P24_MERCHANT_ID=
# ID sklepu — zwykle takie samo jak MERCHANT_ID (jeśli inne, ustaw tutaj).
P24_POS_ID=
P24_CRC=
P24_API_KEY=
# "true" = środowisko testowe (sandbox.przelewy24.pl). Puste/false = produkcja.
P24_SANDBOX=

# ── Płatności online (alternatywnie Stripe: BLIK, Przelewy24, karta) ──
# Używane tylko, gdy nie ustawiono Przelewy24. Klucze z dashboard.stripe.com.
STRIPE_SECRET_KEY=
# Sekret webhooka z Stripe → Developers → Webhooks (endpoint: /api/platnosc/webhook,
# zdarzenie checkout.session.completed).
STRIPE_WEBHOOK_SECRET=
# Adres sklepu do przekierowań po płatności (np. https://fasolka.pl). Jeśli pusty,
# brany jest z nagłówków żądania.
NEXT_PUBLIC_BAZOWY_URL=

# ── Powiadomienia e-mail (Resend) ──
# Bez klucza zamówienia zapisują się, ale bez maili. Klucz: resend.com → API Keys.
RESEND_API_KEY=
# Nadawca (musi być na zweryfikowanej domenie w Resend; na start działa
# "bobas-shopping <onboarding@resend.dev>"). Adres sklepu = powiadomienie o zamówieniu.
MAIL_FROM=
MAIL_SKLEP=
# Sekret cotygodniowego newslettera (Vercel Cron). Ustaw dowolny długi ciąg —
# Vercel automatycznie dołączy go jako Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=
# Opcjonalny sekret podpisu linków wypisu (domyślnie pochodna RESEND_API_KEY).
NEWSLETTER_SECRET=

# Google Analytics 4 (opcjonalne) — identyfikator pomiaru, np. G-XXXXXXXXXX.
# GA ładuje się dopiero po zgodzie na cookies ("Akceptuję wszystkie").
NEXT_PUBLIC_GA_ID=
